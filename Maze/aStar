import heapq

class Node:
    def __init__(self, state, parent, act, cost_path, g):
        self.state = state
        self.parent = parent
        self.act = act
        self.cost_path = cost_path  # f(n) = g(n) + h(n)
        # g(n): chi phí thực tế đã đi từ vị trí xuất phát (Start) cho đến vị trí hiện tại (n).
        # h(n): dự đoán chi phí tối ưu nhất để đi từ vị trí hiện tại (n) đến vị trí đích (Goal).
        self.g = g

    def __lt__(self, other):
        return self.cost_path < other.cost_path

class AStar:
    def __init__(self, initial_maze, goal=(19, 19)):
        self.goal = goal # Nhận toạ độ đích từ app.py

        # Tính toán node bắt đầu dựa trên initial_maze
        start_node = Node(initial_maze, None, "START", self.mahattan(initial_maze), 0)

        self.frontier = []
        self.reached = {self.matrix_to_tuple(initial_maze)}
        heapq.heappush(self.frontier, start_node)

    def matrix_to_tuple(self, matrix):
        tmp_lst = []

        for i in range(len(matrix)):
            for j in range(len(matrix[0])):
                tmp_lst.append(matrix[i][j])
        return tuple(tmp_lst)
    
    # tham số get_location của aStar là matrix do cần tính trước khi khởi tạo node
    def get_location(self, matrix):
        for i in range(len(matrix)):
            for j in range(len(matrix[0])):
                if matrix[i][j] == 3:
                    return i, j
        return None, None
    
    def possible_move(self, node):
        matrix = node.state
        x, y = self.get_location(node.state)
        move = []

        if x > 0 and matrix[x-1][y] != 1:
            move.append("up")
        if x < len(matrix) - 1 and matrix[x+1][y] != 1:
            move.append("down")
        if y > 0 and matrix[x][y-1] != 1:
            move.append("left")
        if y < len(matrix[0]) - 1 and matrix[x][y+1] != 1:
            move.append("right")

        return move
    
    def act(self, node, m):
        matrix = [row[:] for row in node.state]
        x, y = self.get_location(node.state)

        if m == "up":
            matrix[x][y], matrix[x-1][y] = matrix[x-1][y], matrix[x][y]

        if m == "down":
            matrix[x][y], matrix[x+1][y] = matrix[x+1][y], matrix[x][y]
        
        if m == "left":
            matrix[x][y], matrix[x][y-1] = matrix[x][y-1], matrix[x][y]
        
        if m == "right":
            matrix[x][y], matrix[x][y+1] = matrix[x][y+1], matrix[x][y]

        return Node(matrix, node, m, node.g + 1 + self.mahattan(matrix), node.g + 1)
    
    def is_goal(self, node):
        x, y = self.get_location(node.state)
        if x == self.goal[0] and y == self.goal[1]:
            return True
        return False
    
    def get_path(self, node):
        path = []

        while node != None:
            path.append((node.state, node.act))
            node = node.parent
        
        return path[::-1]
    
    def print_matrix(self, matrix):
        for i in range(len(matrix)):
            for j in range(len(matrix[0])):
                print(matrix[i][j], end = " ")
            print()

    def mahattan(self, matrix):
        x, y = self.get_location(matrix)
        return abs(x - self.goal[0]) - abs(y - self.goal[1])

    def solve(self):

        while len(self.frontier):
            node = heapq.heappop(self.frontier)
            move = self.possible_move(node)

            for m in move:
                new_node = self.act(node, m)
                
                if self.is_goal(new_node):
                    return new_node
                
                if self.matrix_to_tuple(new_node.state) not in self.reached:
                    heapq.heappush(self.frontier, new_node)
                    self.reached.add(self.matrix_to_tuple(new_node.state))
        return None

    def run(self):

        node = self.solve()

        if node == None:
            print("!!! Không thể thoát khỏi mê cung")
            return
        
        path = self.get_path(node)

        for i, p in enumerate(path):
            print(f"Step {i+1}")
            self.print_matrix(p[0])
            print(f"Action: {p[1]}")
            print("=" * 50)
        
        print("Đã giải mã thành công mê cung")
    
